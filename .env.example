# ==============================================================================
# MCX Gold RVA — Relative Value Analytics Platform (COZY NEXUS)
# Root Environment Configuration Template (.env.example)
# ==============================================================================

# Application Environment
ENVIRONMENT=development
PROJECT_NAME="MCX Gold RVA — Relative Value Analytics Platform"
VERSION=1.0.0
API_V1_STR=/api

# Database Connection
# For local SQLite development (zero configuration):
DATABASE_URL=sqlite:///./mcx_gold_rva.db

# For PostgreSQL (Docker Compose / Production):
# DATABASE_URL=postgresql+psycopg2://postgres:postgrespassword@localhost:5432/mcx_gold_rva
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgrespassword
# POSTGRES_DB=mcx_gold_rva
# POSTGRES_PORT=5432

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173

# Frontend API URL
VITE_API_BASE_URL=/api

# Financial & Carry Parameters
ANNUAL_RISK_FREE_RATE=0.065
GOLD_STORAGE_INSURANCE_RATE=0.005

# MCX Transaction Charges & Slippage
EXCHANGE_TURNOVER_FEE_PCT=0.000021
SEBI_TURNOVER_FEE_PCT=0.000001
CTT_SELL_PCT=0.0001
GST_PCT=0.18
STAMP_DUTY_BUY_PCT=0.00002
DEFAULT_SLIPPAGE_TICKS=1

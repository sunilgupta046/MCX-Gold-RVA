# MCX Gold RVA - Environment Variables
PROJECT_NAME="MCX Gold RVA — Relative Value Analytics Platform"
VERSION="1.0.0"
API_V1_STR="/api"
ENVIRONMENT="development"

# Database Configuration
# For PostgreSQL (e.g. Docker Compose or local PostgreSQL):
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mcx_gold_rva
# For Local Zero-Setup Dev (SQLite):
DATABASE_URL=sqlite:///./mcx_gold_rva.db

# CORS Configuration (comma-separated or JSON list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://localhost:4173

# Analytics & Carry Parameters
ANNUAL_RISK_FREE_RATE=0.065
GOLD_STORAGE_INSURANCE_RATE=0.005

# MCX Transaction Charges
EXCHANGE_TURNOVER_FEE_PCT=0.000021
SEBI_TURNOVER_FEE_PCT=0.000001
CTT_SELL_PCT=0.0001
GST_PCT=0.18
STAMP_DUTY_BUY_PCT=0.00002
DEFAULT_SLIPPAGE_TICKS=1
